# Dev-Image (ADR-0007). cmake: lazy_html/lexbor-Source-Build (kein
# vorkompiliertes Binary für dieses Elixir/OTP). inotify-tools: Live-Reload.
FROM elixir:1.20

RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake inotify-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
