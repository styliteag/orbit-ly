# Stylite Orbit-ly — production configuration.
#
# Template: `cp .env.example .env`, set the values, then
# `docker compose -f compose.prod.yml up -d`. The real `.env` is gitignored
# (contains secrets) — never check it in.

# --- Required ---

# Image tag (ghcr.io/styliteag/orbit-ly:<version>). `latest` or pin it.
ORBITLY_VERSION=0.1.6

# Primary domain = dashboard host. Set as the primary domain's hostname at boot;
# changing it moves the dashboard + all links living on it to the new domain.
# No script needed.
MAIN_DOMAIN=go.example.com

# Cookie/session signature, >= 64 characters.
#   openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# SMTP relay used for password-reset emails. Use the relay hostname, not a
# URL. The sender domain should have SPF/DKIM configured at your mail provider.
SMTP_RELAY=smtp.example.com
MAIL_FROM=noreply@example.com

# --- Optional (defaults shown) ---

# HTTP port inside the container (Traefik points here).
PORT=4000

# DB connection pool.
POOL_SIZE=10

# Number of trusted reverse proxies in front of the app. Traefik = 1; with a
# CDN/LB in front as well: increase it (otherwise click IP & rate limit act on
# the wrong x-forwarded-for entry).
TRUSTED_PROXY_HOPS=1

# Display name used in the From header.
MAIL_FROM_NAME=Orbit-ly

# SMTP credentials. Set both for an authenticated relay, leave both unset (or
# empty) for an internal relay without AUTH. Setting only one aborts the boot.
SMTP_USERNAME=
SMTP_PASSWORD=

# Submission port. Authenticated providers: 587. Internal relay without AUTH:
# usually 25.
SMTP_PORT=587

# always    = STARTTLS enforced, relay certificate verified (default)
# if_available = STARTTLS when the relay offers it
# never     = plaintext; only for a trusted internal network, the mail
#             (including the reset link) then travels unencrypted.
SMTP_TLS=always
