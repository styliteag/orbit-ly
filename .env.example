# Stylite Orbit-ly — Produktions-Konfiguration.
#
# Kopiervorlage: `cp .env.example .env`, Werte setzen, dann
# `docker compose -f compose.prod.yml up -d`. Die echte `.env` ist gitignored
# (enthält Secrets) — niemals einchecken.

# --- Pflicht ---

# Image-Tag (ghcr.io/styliteag/orbit-ly:<version>). `latest` oder pinnen.
ORBITLY_VERSION=0.1.6

# Hauptdomain = Dashboard-Host = Primärdomain. Wird beim Boot als Hostname der
# Primärdomain gesetzt; ändern zieht Dashboard + alle dort liegenden Links auf
# die neue Domain um. Kein Script nötig.
MAIN_DOMAIN=go.example.com

# Cookie-/Session-Signatur, >= 64 Zeichen.
#   openssl rand -base64 64 | tr -d '\n'
SECRET_KEY_BASE=

# Signatur der Auth-Tokens.
#   openssl rand -base64 48 | tr -d '\n'
TOKEN_SIGNING_SECRET=

# --- Optional (Defaults gezeigt) ---

# HTTP-Port im Container (Traefik zeigt hierhin).
PORT=4000

# DB-Connection-Pool.
POOL_SIZE=10

# Anzahl vertrauenswürdiger Reverse-Proxies vor der App. Traefik = 1; steht
# noch ein CDN/LB davor: erhöhen (sonst Klick-IP & Rate-Limit am falschen
# x-forwarded-for-Eintrag).
TRUSTED_PROXY_HOPS=1
